# MaroFlux PDE-ODE Repository — Git Ignore Rules
# ================================================

# ── Python cache & bytecode ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# ── Virtual environments ──────────────────────────────────────────────────────
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
dist/
build/

# ── Jupyter Notebooks checkpoints ────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Generated figures (regenerate by running the script) ─────────────────────
# NOTE: figures/ IS committed for reproducibility (reviewers can verify outputs)
# Uncomment the lines below ONLY if you prefer to exclude auto-generated figures:
# figures/
# *.pdf
# *.png
# *.svg

# ── Large data files (if simulation produces HDF5/NetCDF outputs) ─────────────
*.h5
*.hdf5
*.nc
*.npy
*.npz

# ── OS-specific files ─────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE / editor configurations ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# ── Testing & coverage ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml

# ── Temporary files ───────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.orig
temp/
tmp/

# ── Sensitive / personal configuration ───────────────────────────────────────
.env.local
secrets.py
config_local.py

# ── Files NOT to ignore (force-include for reproducibility) ───────────────────
# These are explicitly tracked even if their extensions appear above:
!calibrated_params_pde_ode.json
!sobol_sensitivity_results_pde_ode.json
!requirements.txt
!README.md
!LICENSE
!maroflux_solver_complete.py
!figures/MaroFlux_Complete_Output.pdf
